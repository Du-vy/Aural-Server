{
  "server": {
    "name": "Aural Server",
    "description": "A self-hosted Aural server",
    "bind": "0.0.0.0",
    "port": 9871,
    "password": "",
    "max_users": 64,
    "allowed_origins": [
      "*"
    ]
  },
  "registration": {
    "enabled": true,
    "allow_guests": true,
    "min_password_length": 8,
    "min_username_length": 3,
    "max_username_length": 32
  },
  "voice": {
    "enabled": true,
    "mode": "server_host",
    "sample_rate": 48000,
    "bitrate": 64000,
    "min_bitrate": 16000,
    "max_bitrate": 128000,
    "fec": true,
    "dtx": false,
    "stereo": false,
    "max_participants": 0,
    "public_ip": "",
    "udp_port_min": 0,
    "udp_port_max": 0,
    "ice_servers": []
  },
  "uploads": {
    "enabled": true,
    "path": "uploads",
    "max_file_bytes": 52428800,
    "max_avatar_bytes": 8388608,
    "max_banner_bytes": 16777216,
    "max_total_bytes": 5368709120,
    "max_per_message": 10,
    "pending_ttl_minutes": 60
  },
  "unfurl": {
    "enabled": true,
    "cache_ttl_days": 7
  },
  "integrations": {
    "klipy_api_key": ""
  },
  "tls": {
    "enabled": false,
    "cert_file": "",
    "key_file": ""
  },
  "database": {
    "path": "aural.db"
  },
  "log": {
    "level": "info",
    "format": "pretty",
    "file": "",
    "file_level": "info",
    "file_format": "json",
    "no_color": false
  }
}
